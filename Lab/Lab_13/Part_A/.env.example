# HTTP port used by the Express server
PORT=5000

# MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/experiment13_auth

# Use a long, random value in your real .env file; never commit it.
JWT_SECRET=replace_with_a_long_random_secret

# Optional JWT lifetime accepted by jsonwebtoken
JWT_EXPIRES_IN=7d
