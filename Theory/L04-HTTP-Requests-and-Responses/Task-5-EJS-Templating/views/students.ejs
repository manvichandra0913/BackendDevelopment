<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <ul>
      <% students.forEach((student) => { %>
        <li>
          <strong><%= student.name %></strong> - <%= student.course %>
        </li>
      <% }); %>
    </ul>
  </body>
</html>